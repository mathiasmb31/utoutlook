#!/bin/bash
# Règle Mathias 2026-11-06 — NE JAMAIS POUSSER LES .click (TOUS projets)
# Bloque tout push dont les nouveaux objets contiennent un fichier .click.
# Activer dans chaque dépôt : git config core.hooksPath githooks
# Les .click restent en local (git add -f, gitignorés) ; procédure de push
# filtré : base-de-connaissances/restauration-workspace-vibe-2026-11-06.md
ZERO=0000000000000000000000000000000000000000
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue   # suppression de ref : rien à pousser
    if [ "$remote_sha" = "$ZERO" ]; then
        range="$local_sha --not --all"        # nouvelle branche : objets inédits
    else
        range="$remote_sha..$local_sha"
    fi
    # liste les chemins des nouveaux objets et cherche un .click
    bad=$(git rev-list --objects $range | awk '{print $2}' | grep '\.click$' | head -5)
    if [ -n "$bad" ]; then
        echo "ERREUR (règle Mathias 2026-11-06) : ce push contient des .click :" >&2
        echo "$bad" >&2
        echo "Les .click ne partent JAMAIS sur un dépôt distant (reconstructibles," >&2
        echo "conservés en local via git add -f). Push filtré :" >&2
        echo "  base-de-connaissances/restauration-workspace-vibe-2026-11-06.md" >&2
        rc=1
    fi
done
exit $rc
