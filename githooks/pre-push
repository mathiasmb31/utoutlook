#!/bin/bash
# Règle Mathias 2026-11-06 — NE JAMAIS POUSSER LES .click (TOUS projets)
# + garde-fou taille 2026-11-08 : bloque aussi tout blob > MAX_PUSH_FILE_MB Mo
# (défaut 100 = limite dure GitHub). Surcharger : MAX_PUSH_FILE_MB=200 git push ...
# Activer dans chaque dépôt : git config core.hooksPath githooks
# Les .click restent en local (git add -f, gitignorés) ; procédure de push
# filtré : base-de-connaissances/restauration-workspace-vibe-2026-11-06.md
ZERO=0000000000000000000000000000000000000000
MAX_MB="${MAX_PUSH_FILE_MB:-100}"
MAX_BYTES=$((MAX_MB * 1024 * 1024))
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue   # suppression de ref : rien à pousser
    if [ "$remote_sha" = "$ZERO" ]; then
        range="$local_sha --not --all"        # nouvelle branche : objets inédits
    else
        range="$remote_sha..$local_sha"
    fi
    # chemins des nouveaux objets : .click interdits
    bad=$(git rev-list --objects $range | awk '{print $2}' | grep '\.click$' | head -5)
    if [ -n "$bad" ]; then
        echo "ERREUR (règle Mathias 2026-11-06) : ce push contient des .click :" >&2
        echo "$bad" >&2
        echo "Les .click ne partent JAMAIS sur un dépôt distant (reconstructibles," >&2
        echo "conservés en local via git add -f). Push filtré :" >&2
        echo "  base-de-connaissances/restauration-workspace-vibe-2026-11-06.md" >&2
        rc=1
    fi
    # tailles des nouveaux blobs : > MAX_PUSH_FILE_MB Mo interdit
    big=$(git rev-list --objects $range | git cat-file --batch-check='%(objecttype) %(objectsize) %(rest)' \
          | awk -v max="$MAX_BYTES" '$1=="blob" && $2>max {print $3, $2}' | head -5)
    if [ -n "$big" ]; then
        echo "ERREUR (garde-fou taille, ${MAX_MB} Mo max) : ce push contient des fichiers trop gros :" >&2
        echo "$big" | awk -v m=1048576 '{printf "  %s : %.1f Mo\n", $1, $2/m}' >&2
        echo "  Surcharger : MAX_PUSH_FILE_MB=<Mo> git push" >&2
        rc=1
    fi
done
exit $rc
