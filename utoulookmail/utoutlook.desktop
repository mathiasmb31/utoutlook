[Desktop Entry]
Name=UToutlook Mail
Exec=./bin/command.sh
Icon=assets/logo.png
Terminal=false
Type=Application
X-Lomiri-Touch=true
X-Ubuntu-Touch=true
X-Ubuntu-XMir-Enable=true
# v4.2.2: associe la fenêtre Electron à l'ID NON VERSIONNÉ attendu par le
# Launcher model de Lomiri (favori `appid://utoutlook.mathias_utoutlook`).
# L'ID versionné (v4.1.9→v4.2.1) faisait créer une icône jaune « inconnue »
# et bloquait le splash : "app that's not in the Launcher model".
StartupWMClass=utoutlook.mathias_utoutlook
